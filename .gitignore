coverage.json
# Dotenv files carry secrets once populated. A pattern without a wildcard matches one literal name, so a bare
# `.env` would leave every sibling (.env.local, .env.production, .envrc, ...) untracked but stageable by
# `git add -A`, in a PUBLIC repository. A slash-free pattern matches at any depth, so this one rule also covers
# subdirectories - unlike .dockerignore, which is root-anchored and needs a second, `**/`-prefixed line.
# Re-include the public template last: the last matching pattern wins.
.env*
!.env.example
typechain-types
dist
zkvm/guest/target/
zkvm/host/target/
zkvm/evidence-validator/target/
zkvm/relation-tests/target/

# IDEs and Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# ...except the SP1 canonical rebuild's raw records, which are evidence (the container's run.log among them).
!evidence/zk/sp1-impl/observations/**/run.log

# Docker image exports (large binary files, not for version control)
*.tar.gz
*.tar
# ...except SP1-PA2A's synthetic test archives. A real circuit archive (v6.1.0-groth16.tar.gz) stays ignored everywhere,
# test/fixtures included: it is mirrored by WalletWall, never committed.
!test/fixtures/sp1-proving-archives/synthetic-*.tar.gz

# Raw Slither JSON emitted by the vNext Kernel workflow's single scan (alongside the SARIF).
# It is an INPUT to the triage gate, never an artifact to commit: it embeds filename_absolute,
# so its bytes differ per machine even when the findings are identical.
prototype/vnext-kernel/slither-raw.json
